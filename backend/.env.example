# Generate a local app token: uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
MONITOR_API_TOKEN=
# Optional: organization Admin API credential; never use this in mobile code.
OPENAI_ADMIN_KEY=
# Defaults are backend/data/monitor.sqlite3 and Australia/Brisbane.
# MONITOR_DATABASE_PATH=/absolute/path/monitor.sqlite3
# MONITOR_TIMEZONE=Australia/Brisbane
# The server runs the monitoring loop by default. Disable it for dedicated API-only/test processes.
# MONITOR_SCHEDULER_ENABLED=false
# Budget, interval and desktop-notification settings are persisted through /v1/monitor/settings.
